# ====================================================================
# INVEST-AI PRO • REAL OTP AUTHENTICATION CONFIGURATION
# ====================================================================
# Follow these 3 simple steps to receive REAL SMS on your mobile phone:
# 1. Visit https://console.firebase.google.com/ and create a free project.
# 2. Go to "Authentication" -> "Sign-in method" -> Enable "Phone" and "Email".
# 3. Go to Project Settings (gear icon) -> Scroll to "Your apps" -> Add Web App (</>).
# 4. Copy the keys below and paste them into this file:

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ====================================================================
# (Optional) REAL EMAIL 6-DIGIT OTP VIA EMAILJS (https://www.emailjs.com)
# Free 200 emails/month directly into your inbox with zero backend.
# ====================================================================
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
